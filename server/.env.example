# ========================================================
# WixFox Studio — Database & Cloud Server Configuration
# ========================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:3000,capacitor://localhost,ionic://localhost,file://*

# Database Mode: 'local' (Auto-persistent JSON DB) or 'postgres' (PostgreSQL / Supabase / Neon)
# To connect to Cloud PostgreSQL (Supabase/Neon/Render/AWS RDS), uncomment and paste your connection string:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wixfox_erp

# Local Storage & Database Directory
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Backup & Cloud GitHub Snapshot Interval (minutes)
BACKUP_INTERVAL_MINUTES=60
AUTO_SNAPSHOT_ON_CHANGE=true
