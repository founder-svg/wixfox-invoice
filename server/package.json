{
  "name": "wixfox-server",
  "version": "1.0.0",
  "description": "WixFox Studio - Official High-Performance Local & Cloud Database Server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:seed": "node src/scripts/seed.js",
    "db:backup": "node src/scripts/backup.js",
    "prod:start": "pm2 start ecosystem.config.cjs --env production",
    "prod:stop": "pm2 stop ecosystem.config.cjs",
    "prod:restart": "pm2 reload ecosystem.config.cjs",
    "prod:logs": "pm2 logs wixfox-server",
    "prod:status": "pm2 status"
  },
  "keywords": [
    "wixfox",
    "agency-erp",
    "database-server",
    "cloud-storage",
    "express",
    "postgresql",
    "supabase"
  ],
  "author": "WixFox Technologies",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
